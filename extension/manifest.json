{
  "manifest_version": 3,
  "name": "Plico Helium Companion",
  "version": "0.4.0",
  "description": "Native keyboard navigation for Helium",
  "key": "",
  "permissions": [
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "storage",
    "history",
    "bookmarks",
    "search",
    "favicon",
    "debugger"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
